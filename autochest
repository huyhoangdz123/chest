-- ════════════════════════════
-- MAIN FARM LOOP
-- ════════════════════════════
print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")
print("[ChestFarm] ✅ Script 1 đã load!")
print("[ChestFarm] 🔄 Đang bắt đầu farm rương...")
print("[ChestFarm] 🏆 Tự dừng khi ra: God's Chalice / Fist of Darkness")
print("[ChestFarm] 💡 Chạy Script 2 để dừng thủ công")
print("━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━")

task.spawn(function()
    while _G.ChestFarm_Running do

        -- ── Check đồ hiếm real-time ──
        if rareDetected then
            stopFarm("Nhặt được " .. rareItemName .. "!")
            return
        end

        -- ── Cập nhật character ──
        if not updateChar() then task.wait(1) continue end
        if Humanoid.Health <= 0 then task.wait(2) continue end

        -- ── Tìm rương ──
        local chests = findChestsSorted()

        if #chests == 0 then
            print("[ChestFarm] ⏳ Không có rương - chờ spawn...")
            task.wait(2)
            continue
        end

        -- ── Mở từng rương ──
        for _, chest in ipairs(chests) do
            if not _G.ChestFarm_Running then break end
            if rareDetected then break end
            if not chest.obj.Parent then continue end
            if not updateChar() then break end
            if Humanoid.Health <= 0 then break end

            local dist = (HRP.Position - chest.pos).Magnitude

            -- Tween đến rương
            if dist > PickupRange then
                tweenTo(chest.pos)
            end

            task.wait(0.15)

            -- Rương còn tồn tại?
            if not chest.obj.Parent then continue end

            -- Mở rương
            openChest(chest.obj)
            TotalChests = TotalChests + 1
            print("[ChestFarm] 📦 Mở rương #" .. TotalChests)

            task.wait(0.3)

            -- Check đồ hiếm sau khi mở
            if rareDetected then break end
            local rare = scanInventory()
            if rare then
                rareDetected = true
                rareItemName = rare
                break
            end
        end

        task.wait(0.05)
    end

    -- Nếu thoát loop do rareDetected
    if rareDetected and _G.ChestFarm_Running then
        stopFarm("Nhặt được " .. rareItemName .. "!")
    end
end)
end,
})
